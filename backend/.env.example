# Copy to `.env` in this folder (backend/) and adjust. `.env` is gitignored.

# Secrets. When FLASK_DEBUG is off (the default) the server REFUSES TO START
# unless both of these are set — so any real/LAN run is forced onto a real
# secret instead of the committed dev fallback. Use long random strings
# (32+ bytes each), e.g. PowerShell:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=...
# JWT_SECRET_KEY=...
# NOTE: changing JWT_SECRET_KEY invalidates all existing tokens (everyone
# re-logs in once). Messages/users in chat.db are unaffected.

# Access token lifetime in days (default 7). Use 0 to disable expiry (dev only).
# JWT_ACCESS_TOKEN_DAYS=7

# Optional: comma-separated browser origins when you want to lock CORS/Socket.IO
# (e.g. http://localhost:4200,http://192.168.1.10:4200). If unset, defaults stay permissive for LAN dev.
# CORS_ORIGINS=

# Server bind and debug. FLASK_DEBUG defaults to false (production-safe).
# Set it to true for LOCAL DEV ONLY — it enables auto-reload and the Werkzeug
# debugger (which can execute code), and it lets the dev secret fallbacks above
# apply so you don't need to set SECRET_KEY/JWT_SECRET_KEY just to run locally.
# HOST=0.0.0.0
# PORT=3000
# FLASK_DEBUG=true
