# Copy to `.env` in this folder (backend/) and adjust. `.env` is gitignored.

# Required for production-ish LAN use: set long random strings (32+ bytes each).
# SECRET_KEY=...
# JWT_SECRET_KEY=...

# Access token lifetime in days (default 7). Use 0 to disable expiry (dev only).
# JWT_ACCESS_TOKEN_DAYS=7

# Optional: comma-separated browser origins when you want to lock CORS/Socket.IO
# (e.g. http://localhost:4200,http://192.168.1.10:4200). If unset, defaults stay permissive for LAN dev.
# CORS_ORIGINS=

# Server bind and debug
# HOST=0.0.0.0
# PORT=3000
# FLASK_DEBUG=true
